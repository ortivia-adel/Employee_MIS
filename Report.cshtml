@model IEnumerable<EmployeeMIS.Models.Employee>

<div class="container mt-5">
    <div class="card shadow border-0" style="border-radius: 20px;">
        <div class="card-header bg-dark text-white text-center py-4" style="border-radius: 20px 20px 0 0;">
            <h2 class="mb-0"><i class="fas fa-file-invoice me-2"></i> Employees General Report</h2>
        </div>
        <div class="card-body p-4">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Job Title</th>
                        <th>Department</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.JobTitle</td>
                            <td>@(item.Department?.Name ?? "N/A")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>